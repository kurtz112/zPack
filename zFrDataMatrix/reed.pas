function mult(a:Integer;b:Integer):Integer;
var
  sum_log:Integer;
begin

  if ((a = 0) or (b = 0)) then begin
     result:=0;
  end
  else begin

    sum_log := gflog[a] + gflog[b];

    if (sum_log >= N) then sum_log := sum_log-N;
    
    result:=gfi[sum_log];
  end;

end;


procedure calcRS(var data:array of Integer;k:Integer;t2:Integer);
var
i:Integer;
j:Integer;
tmp:Integer;
begin
        N:=255;

        for i := k to (k+t2)-1 do  data[i] := 0;

        for i := 0 to k-1 do
        begin
             tmp := data[k] xor data[i];
	     for j := 0 to t2-1 do
                data[k + j] := (data[k + j + 1] xor mult(tmp, getPolynomialValue(t2,j)));

            data[k+t2-1] := mult(tmp, getPolynomialValue(t2,t2-1));
        end;

end;


{ Add two field elements.  Subtraction and addition are equivalent }
function gfadd (add1:Integer;add2:Integer):Integer;
begin
  result:= add1 xor add2;
end;


