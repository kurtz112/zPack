function zDxGetResourceString(const ResourceName: string): string;
var
  id: TcxResourceStringID;
begin

  result := '';

  if dxResourceStrings.TryGetValue(ResourceName, id) then
    result := cxGetResourceString(id);
end;

procedure zDxSetResourceString(const ResourceName, Value: string);
var
  id: TcxResourceStringID;
begin

  if dxResourceStrings.TryGetValue(ResourceName, id) then
    cxSetResourceString(id, Value);
end;

procedure BuildEnumResources(Resources: TStrings);
var
  idxProduct: Integer;
  idxResource: Integer;
  ResourceName: string;
  res: TList<String>;
  s: string;
begin
  res := TList<String>.Create;
  try
    Resources.BeginUpdate;
    try
      Resources.Clear;

      Resources.Add('Procedure EnumResources;');
      Resources.Add('begin');

      for idxProduct := 0 to dxResourceStringsRepository.ProductsCount - 1 do
      begin
        Resources.Add('  // ' + dxResourceStringsRepository.Products[idxProduct].Name);

        for idxResource := 0 to dxResourceStringsRepository.Products[idxProduct].ResStringsCount - 1 do
        begin
          ResourceName := dxResourceStringsRepository.Products[idxProduct].Names[idxResource];

          if not res.Contains(ResourceName) then
          begin
            res.Add(ResourceName);
            s := Format('  dxResourceStrings.Add(''%s'', @%s);', [ResourceName, ResourceName]);
            Resources.Add(s);
          end;
        end;
      end;
      Resources.Add('end;');
    finally
      Resources.endUpdate;
    end;
  finally
    freeAndNil(res);
  end;
end;

