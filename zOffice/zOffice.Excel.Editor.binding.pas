class function TdxSortOrderHelper.FromString(const Value: string): TdxSortOrder;
begin
  result := soNone;

  if sameText(Value, 'none') then
    result := soNone
  else
    if sameText(Value, 'ascending') then
      result := soAscending
    else
      if sameText(Value, 'descending') then
        result := soDescending;
