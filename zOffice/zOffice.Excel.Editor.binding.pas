  for i := 0 to dxSortedFields.count - 1 do
  begin
    dxSortField := dxSortedFields[i];
    SortField := TSortField.Create;
    sortFields.add(SortField);

    SortField.fieldName := dxSortField.fieldName;
    SortField.sortOrder := dxSortField.sortOrder;
  end;
end;

procedure TDataBinding.LoadFromDetail(dxDetail: TdxSpreadSheetReportDetail; var Detail: TDetail);
begin

  if assigned(dxDetail.dataSource) then
    Detail.dataSource := dxDetail.dataSource.name
  else
    Detail.dataSource := '';

  LoadFromDataGroups(dxDetail.dataGroups, Detail.FdataGroups);
  LoadFromDetails(dxDetail.details, Detail.Fdetails);

  Detail.masterKeyFieldName := dxDetail.masterKeyFieldName;
  Detail.detailKeyFieldName := dxDetail.detailKeyFieldName;

  Detail.options.ansiSort := dxDetail.options.ansiSort;
  Detail.options.caseInsensitive := dxDetail.options.caseInsensitive;
  Detail.options.displayName := dxDetail.options.displayName;

  Detail.sectionId := dxDetail.sectionId;

  LoadFromSortFields(dxDetail.SortedFields, Detail.FsortFields);
end;

procedure TDataBinding.LoadFromDetails(dxDetails: TdxSpreadSheetReportDetails; var details: TObjectList<TDetail>);
var
  i: Integer;
  dxDetail: TdxSpreadSheetReportDetail;
  Detail: TDetail;
begin
  details.clear;

  for i := 0 to dxDetails.count - 1 do
  begin
    dxDetail := dxDetails[i];
    Detail := TDetail.Create;
    details.add(Detail);
    LoadFromDetail(dxDetail, Detail);
  end;
end;

procedure TDataBinding.LoadFromSpreadSheet(ReportDesigner: TdxSpreadSheetReportDesigner);
begin
  assert(assigned(ReportDesigner));

  if assigned(ReportDesigner.DataBinding.dataSource) then
    dataSource := ReportDesigner.DataBinding.dataSource.name
  else
    dataSource := '';

  options.ansiSort := ReportDesigner.DataBinding.options.ansiSort;
  options.caseInsensitive := ReportDesigner.DataBinding.options.caseInsensitive;
  options.displayName := ReportDesigner.DataBinding.options.displayName;

  LoadFromDataGroups(ReportDesigner.DataBinding.dataGroups, FdataGroups);
  LoadFromSortFields(ReportDesigner.DataBinding.SortedFields, FsortFields);
  LoadFromDetails(ReportDesigner.DataBinding.details, Fdetails);
end;

procedure TDataBinding.SaveToDataGroups(dataGroups: TObjectList<TDataGroup>; dxDataGroups: TdxSpreadSheetReportDataGroups);
var
  DataGroup: TDataGroup;
  dxDataGroup: TdxSpreadSheetReportDataGroup;
begin
  dxDataGroups.clear;

  for DataGroup in dataGroups do
  begin
    dxDataGroup := dxDataGroups.add as TdxSpreadSheetReportDataGroup;

    dxDataGroup.fieldName := DataGroup.fieldName;
    dxDataGroup.sortOrder := DataGroup.sortOrder;
    dxDataGroup.sectionId := DataGroup.sectionId;
  end;
end;

procedure TDataBinding.SaveToSortFields(sortFields: TObjectList<TSortField>; dxSortedFields: TdxSpreadSheetReportSortedFields);
var
  i: Integer;
  SortField: TSortField;
  dxSortField: TdxSpreadSheetReportSortedField;
begin
