  for SortField in sortFields do
  begin
    dxSortField := dxSortedFields.add as TdxSpreadSheetReportSortedField;

    dxSortField.fieldName := SortField.fieldName;
    dxSortField.sortOrder := SortField.sortOrder;
  end;
end;

procedure TDataBinding.SaveToDetail(Detail: TDetail; dxDetail: TdxSpreadSheetReportDetail; getDataSourceFunc: TFunc<string, TDataSource>);
begin

  if Detail.dataSource.isEmpty then
    dxDetail.dataSource := nil
  else
    if assigned(getDataSourceFunc) then
      dxDetail.dataSource := getDataSourceFunc(Detail.dataSource);

  SaveToDataGroups(Detail.dataGroups, dxDetail.dataGroups);
  SaveToDetails(Detail.details, dxDetail.details, getDataSourceFunc);

  dxDetail.masterKeyFieldName := Detail.masterKeyFieldName;
  dxDetail.detailKeyFieldName := Detail.detailKeyFieldName;

  dxDetail.options.ansiSort := Detail.options.ansiSort;
  dxDetail.options.caseInsensitive := Detail.options.caseInsensitive;
  dxDetail.options.displayName := Detail.options.displayName;

  dxDetail.sectionId := Detail.sectionId;

  SaveToSortFields(Detail.sortFields, dxDetail.SortedFields);
end;

procedure TDataBinding.SaveToDetails(details: TObjectList<TDetail>; dxDetails: TdxSpreadSheetReportDetails; getDataSourceFunc: TFunc<string, TDataSource>);
var
  i: Integer;
  dxDetail: TdxSpreadSheetReportDetail;
  Detail: TDetail;
begin
  dxDetails.clear;

  for Detail in details do
  begin
    dxDetail := dxDetails.add as TdxSpreadSheetReportDetail;
    SaveToDetail(Detail, dxDetail, getDataSourceFunc);
  end;
end;

procedure TDataBinding.SaveToSpreadSheet(ReportDesigner: TdxSpreadSheetReportDesigner; getDataSourceFunc: TFunc<string, TDataSource>);
begin
  assert(assigned(ReportDesigner));

  if dataSource.isEmpty then
    ReportDesigner.DataBinding.dataSource := nil
  else
    if assigned(getDataSourceFunc) then
      ReportDesigner.DataBinding.dataSource := getDataSourceFunc(dataSource);

  ReportDesigner.DataBinding.options.ansiSort := options.ansiSort;
  ReportDesigner.DataBinding.options.caseInsensitive := options.caseInsensitive;
  ReportDesigner.DataBinding.options.displayName := options.displayName;

  SaveToDataGroups(dataGroups, ReportDesigner.DataBinding.dataGroups);
  SaveToSortFields(sortFields, ReportDesigner.DataBinding.SortedFields);
  SaveToDetails(details, ReportDesigner.DataBinding.details, getDataSourceFunc);
end;

