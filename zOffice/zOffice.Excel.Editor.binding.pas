procedure TDataBinding.LoadFromDataGroups(dxDataGroups: TdxSpreadSheetReportDataGroups; var dataGroups: TObjectList<TDataGroup>);
var
  i: Integer;
  DataGroup: TDataGroup;
  dxDataGroup: TdxSpreadSheetReportDataGroup;
begin
  dataGroups.clear;

  for i := 0 to dxDataGroups.count - 1 do
  begin
    dxDataGroup := dxDataGroups[i];
    DataGroup := TDataGroup.Create;
    dataGroups.add(DataGroup);

    DataGroup.fieldName := dxDataGroup.fieldName;
    DataGroup.sortOrder := dxDataGroup.sortOrder;
    DataGroup.sectionId := dxDataGroup.sectionId;
  end;
end;

procedure TDataBinding.LoadFromSortFields(dxSortedFields: TdxSpreadSheetReportSortedFields; var sortFields: TObjectList<TSortField>);
var
  i: Integer;
  SortField: TSortField;
  dxSortField: TdxSpreadSheetReportSortedField;
begin
